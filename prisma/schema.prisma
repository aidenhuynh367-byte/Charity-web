// Auth.js models + application profile (see https://authjs.dev/getting-started/adapters/prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CHARITY_ORGANIZATION
  CONTRIBUTOR
}

enum DonationListStatus {
  NOT_SUBMITTED
  SUBMITTED
  REVIEWED
}

enum DonationListItemReviewStatus {
  PENDING
  REVIEWED
}

enum DonationListItemCharityDecision {
  ACCEPT
  NOT_ACCEPT
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  profile        Profile?
  donationLists  DonationList[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// 1:1 with User. Role-specific fields are validated in app code (Zod).
model Profile {
  userId                 String    @id
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                   Role?
  /// Charity organization name
  organizationName       String?
  address                String?
  /// ISO 3166-1 alpha-2; national subscriber number stored as digits only.
  phoneCountry                   String?
  phoneNationalNumber            String?
  charityWhatsappCountry         String?
  charityWhatsappNationalNumber  String?
  charityEmail           String?
  /// Contributor display name
  displayName            String?
  contributorWhatsappCountry         String?
  contributorWhatsappNationalNumber String?
  onboardingCompletedAt  DateTime?
  updatedAt              DateTime  @updatedAt
}

model DonationList {
  id                       String              @id @default(cuid())
  name                     String
  status                   DonationListStatus  @default(NOT_SUBMITTED)
  createdAt                DateTime            @default(now())
  contributorId            String
  contributor              User                @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  items                    DonationListItem[]
  /// Optional message when charity uses "Respond to contributor".
  charityResponseMessage   String?             @db.Text
  charityRespondedAt       DateTime?

  @@index([contributorId, createdAt])
}

model DonationListItem {
  id              String                         @id @default(cuid())
  description     String                         @db.Text
  /// Public URL paths under /uploads/...
  imageUrl1       String?
  imageUrl2       String?
  donationListId  String
  donationList    DonationList                   @relation(fields: [donationListId], references: [id], onDelete: Cascade)
  createdAt       DateTime                       @default(now())
  reviewStatus    DonationListItemReviewStatus   @default(PENDING)
  charityDecision DonationListItemCharityDecision?

  @@index([donationListId])
}
