
# =============================================================================
# Local development (PostgreSQL on localhost)
# =============================================================================

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/charity_web?schema=public"
# Same as DATABASE_URL for local dev; use Cloud SQL Auth Proxy URL for prod migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/charity_web?schema=public"

# =============================================================================
# Production — Cloud SQL (cross-project, Option B)
# Instance lives in project-3735bbba-0864-4d45-a7a (NOT charity-link-f61ff).
# Connection name: project-3735bbba-0864-4d45-a7a:asia-southeast2:free-trial-first-project
#
# DATABASE_URL (runtime — App Hosting Unix socket):
# postgresql://postgres:PASSWORD@localhost/charityweb?host=/cloudsql/project-3735bbba-0864-4d45-a7a:asia-southeast2:free-trial-first-project&schema=public&connection_limit=5
#
# DIRECT_DATABASE_URL (migrations via Cloud SQL Auth Proxy on your machine):
#   1. cloud-sql-proxy project-3735bbba-0864-4d45-a7a:asia-southeast2:free-trial-first-project --port 5433
#   2. DIRECT_DATABASE_URL="postgresql://postgres:PASSWORD@127.0.0.1:5433/charityweb?schema=public"
# Then: npm run db:migrate:deploy
#
# Cross-project IAM (required before deploy):
#   gcloud projects add-iam-policy-binding project-3735bbba-0864-4d45-a7a \
#     --member="serviceAccount:firebase-app-hosting-compute@charity-link-f61ff.iam.gserviceaccount.com" \
#     --role="roles/cloudsql.client"
# After first deploy, confirm the service account in Firebase console → App Hosting →
# charity-link-backend → Settings, and grant roles/cloudsql.client if it differs.
#
# Store both URLs as Firebase secrets:
#   firebase apphosting:secrets:set charityWebDatabaseUrl
#   firebase apphosting:secrets:set charityWebDirectDatabaseUrl

# =============================================================================
# Cloud Storage (production uploads — omit locally to use public/uploads/)
# =============================================================================
# GCS_UPLOAD_BUCKET="charity-link-f61ff.firebasestorage.app"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of this app (no trailing slash), e.g. http://localhost:3000
# When set, Auth.js uses this for OAuth redirect_uri (not the browser/ngrok host). For ngrok, set this to your https://….ngrok-free.dev origin while testing.
AUTH_URL="http://localhost:3000"

# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra (Azure AD) — tenant can be a GUID or "common"
# Register redirect URI: {AUTH_URL}/api/auth/callback/azure-ad (e.g. http://localhost:3000/api/auth/callback/azure-ad)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Wasender (WhatsApp) — server only. Session id is your sender session in Wasender (not recipient phones).
# Session API key: WASENDER_API_KEY or WASENDER_MESSAGING_API_KEY — used for POST /api/send-message and GET /api/status.
# Personal access token: WASENDER_PERSONAL_ACCESS_TOKEN (or WASENDER_BEARER_TOKEN) — required for POST connect/disconnect
#   and GET /api/whatsapp-sessions/:id. If you omit the PAT, this app sends without connect/disconnect (messaging-only).
# Recommended: set both PAT (connect lifecycle) and messaging key (send), or messaging key only if your session is already usable.
WASENDER_WHATSAPP_SESSION_ID=""
WASENDER_API_KEY=""
# WASENDER_PERSONAL_ACCESS_TOKEN=""
# WASENDER_MESSAGING_API_KEY=""
# WASENDER_BEARER_TOKEN=""  # alias of PAT if you prefer this name
# Optional; default https://www.wasenderapi.com
# WASENDER_API_BASE_URL="https://www.wasenderapi.com"
# Optional: comma-separated User ids (Profile.userId) to notify on list submit only; omit to notify all charity profiles with WhatsApp.
# WASENDER_NOTIFY_CHARITY_USER_IDS=""
# Optional public origin if AUTH_URL is unset (notification links).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
