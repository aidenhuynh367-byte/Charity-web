# Instagram — register redirect: {AUTH_URL}/api/auth/callback/instagram (HTTPS in production; ngrok for local).
# Use Instagram App ID + Instagram App Secret from: App > Instagram > API setup with Instagram login > Business login settings.
# Do not use the generic Facebook App ID/Secret from Settings > Basic unless you are on legacy Basic Display (see below).
# Default flow matches Meta’s “Instagram API with Instagram Login” (authorize on www.instagram.com, scope instagram_business_basic).
# INSTAGRAM_SCOPES="instagram_business_basic,instagram_business_manage_comments"  # optional; comma-separated
# INSTAGRAM_OAUTH_LEGACY=true  # only if you still use deprecated Instagram Basic Display (api.instagram.com + user_profile,user_media)
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Firebase Cloud Messaging (Web Push) — public web config from Firebase Console > Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Cloud Messaging > Web Push certificates > Key pair (VAPID)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Server-only: Firebase Admin (pick ONE). Never commit real JSON.
# Option A: path to service account JSON file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/serviceAccount.json"
# Option B: single-line JSON (escape newlines; use in hosted env / secrets manager)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#
# Manual FCM check: sign in (onboarded), allow browser notifications, confirm a
# row in FcmWebToken; call sendWebPushToUser(userId, { title, body }) from a
# server action or script with Admin env configured.

# Wasender (WhatsApp) — server only. Session id is your sender session in Wasender (not recipient phones).
# Session API key: WASENDER_API_KEY or WASENDER_MESSAGING_API_KEY — used for POST /api/send-message and GET /api/status.
# Personal access token: WASENDER_PERSONAL_ACCESS_TOKEN (or WASENDER_BEARER_TOKEN) — required for POST connect/disconnect
#   and GET /api/whatsapp-sessions/:id. If you omit the PAT, this app sends without connect/disconnect (messaging-only).
# Recommended: set both PAT (connect lifecycle) and messaging key (send), or messaging key only if your session is already usable.
WASENDER_WHATSAPP_SESSION_ID=""
WASENDER_API_KEY=""
# WASENDER_PERSONAL_ACCESS_TOKEN=""
# WASENDER_MESSAGING_API_KEY=""
# WASENDER_BEARER_TOKEN=""  # alias of PAT if you prefer this name
# Optional; default https://www.wasenderapi.com
# WASENDER_API_BASE_URL="https://www.wasenderapi.com"
# Optional: comma-separated User ids (Profile.userId) to notify on list submit only; omit to notify all charity profiles with WhatsApp.
# WASENDER_NOTIFY_CHARITY_USER_IDS=""
# Optional public origin if AUTH_URL is unset (notification links).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
